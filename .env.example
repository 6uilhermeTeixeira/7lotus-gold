# Reference for local development. Copy settings into each service's own .env.
# The systemd units and Windows runner do not read this root file automatically.
# See services/2lotus/.env.example, services/3lotus/.env.example and
# services/5lotus/.env.example for service-specific settings.

# Shared local data and interface.
LOTUS_DATA_ROOT=/home/ai-agent/lotus-data
LOTUS_UI_PORT=7771

# Research and operations backends. Leave blank until configured locally.
DAYTRADE_SUPABASE_URL=
DAYTRADE_SUPABASE_SERVICE_ROLE_KEY=
DAYTRADE_INGEST_API_KEY=
DAYTRADE_DASHBOARD_PASSWORD=
DAYTRADE_SESSION_SECRET=
LOTUS_OPERATIONAL_EVENT_TOKEN=

# Runner and telemetry. Execution remains disabled by default.
LOTUS_RUNNER_API_KEY=
LOTUS_RUNNER_EXECUTION_ENABLED=false
LOTUS_RUNNER_ALLOWED_ACCOUNT_LOGIN=0
LOTUS_TELEMETRY_URL=
LOTUS_TELEMETRY_TOKEN=

# Legacy decision API guard; never enable based only on a backtest.
DAYTRADE_ENABLE_LIVE_DECISIONS=false
LIVE_CANARY_ARMED=false
LIVE_CANARY_ACCOUNT_LOGIN=0
