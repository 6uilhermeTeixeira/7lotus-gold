[Unit]
Description=Gold Lotus unified local interface
After=lotus-local-1.service lotus-local-2.service lotus-local-3.service lotus-local-4.service lotus-local-5.service
Wants=lotus-local-1.service lotus-local-2.service lotus-local-3.service lotus-local-4.service lotus-local-5.service

[Service]
Type=simple
WorkingDirectory=/home/ai-agent/projects/7lotus-gold/apps/unified-ui
Environment=LOTUS_UI_PORT=7771
ExecStart=/usr/bin/python3 /home/ai-agent/projects/7lotus-gold/apps/unified-ui/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=gold-lotus.target
